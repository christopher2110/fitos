{
  "id": "phul",
  "slug": "phul",
  "name": "PHUL — Power Hypertrophy Upper Lower",
  "author": "Brandon Campbell",
  "source": "Public domain powerbuilding methodology, popularized by Brandon Campbell Diamond",
  "goal": "powerbuilding",
  "difficulty": "intermediate",
  "daysPerWeek": 4,
  "durationWeeks": 12,
  "description": "PHUL trains each muscle group twice weekly with one power-focused day (low rep, high intensity) and one hypertrophy day (moderate rep, volume). Upper body on days 1 & 3, lower body on days 2 & 4. The best of both worlds — strength and size.",
  "equipment": ["barbell", "dumbbell", "cables", "rack", "bench"],
  "tags": ["powerbuilding", "upper-lower", "strength", "hypertrophy"],
  "weeks": [
    {
      "week": 1,
      "label": "Week 1 — Foundation",
      "phase": "Base Block",
      "days": [
        {
          "day": "Monday",
          "focus": "Upper Power",
          "exercises": [
            { "name": "Bench Press", "sets": "3-4", "reps": "3-5", "load": "RPE 8-9", "rest": "240", "notes": "Heavy. Take 15–20 min on this movement." },
            { "name": "Barbell Row", "sets": "3-4", "reps": "3-5", "load": "RPE 8-9", "rest": "210", "notes": "Heavier row day — pronated grip." },
            { "name": "Incline DB Press", "sets": "3", "reps": "8", "load": "RPE 7", "rest": "120", "notes": "Supplemental pressing." },
            { "name": "Lat Pulldown", "sets": "3", "reps": "8", "load": "RPE 7", "rest": "90", "notes": "" },
            { "name": "DB Lateral Raise", "sets": "3", "reps": "12", "load": "RPE 8", "rest": "60", "notes": "" },
            { "name": "EZ Bar Curl", "sets": "3", "reps": "8", "load": "RPE 8", "rest": "60", "notes": "" },
            { "name": "Skull Crushers", "sets": "3", "reps": "8", "load": "RPE 8", "rest": "60", "notes": "" }
          ]
        },
        {
          "day": "Tuesday",
          "focus": "Lower Power",
          "exercises": [
            { "name": "Back Squat", "sets": "3-4", "reps": "3-5", "load": "RPE 8-9", "rest": "300", "notes": "Main power movement. Prioritize depth and bar path." },
            { "name": "Deadlift", "sets": "3-4", "reps": "3-5", "load": "RPE 8-9", "rest": "300", "notes": "Heavy conventional. Can use straps." },
            { "name": "Leg Press", "sets": "3", "reps": "10", "load": "RPE 7", "rest": "120", "notes": "Supplemental quad work." },
            { "name": "Leg Curl", "sets": "3", "reps": "10", "load": "RPE 7", "rest": "90", "notes": "" },
            { "name": "Standing Calf Raise", "sets": "4", "reps": "12", "load": "RPE 8", "rest": "60", "notes": "" }
          ]
        },
        {
          "day": "Thursday",
          "focus": "Upper Hypertrophy",
          "exercises": [
            { "name": "Incline Barbell Press", "sets": "4", "reps": "10", "load": "RPE 7-8", "rest": "90", "notes": "Hypertrophy focus — more volume, shorter rest." },
            { "name": "Cable Row", "sets": "4", "reps": "10", "load": "RPE 7-8", "rest": "90", "notes": "" },
